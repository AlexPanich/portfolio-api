# Local development (app on the host, database from `docker compose up -d db`)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5434/portfolio
DEFAULT_PROFILE_SLUG=alexpanich
# Print every SQL statement: useful to see DataLoader batching in action
LOG_SQL=false

# S3-compatible storage (MinIO from `docker compose up -d minio`).
# Leave S3_BUCKET empty to run without storage: `avatar` is then null.
S3_BUCKET=portfolio
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY_ID=portfolio
S3_SECRET_ACCESS_KEY=portfolio-secret
S3_FORCE_PATH_STYLE=true
